<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Douane Temporelle" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
        <EditText android:id="@+id/et_nom_xx" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nom du voyageur" android:inputType="textPersonName"/>
        <EditText android:id="@+id/et_naissance_xx" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Année de naissance (ex: 1990)" android:inputType="number" android:maxLength="4"/>
        <EditText android:id="@+id/et_destination_xx" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Année de destination (ex: 2050)" android:inputType="number" android:maxLength="4"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Motif du voyage" android:layout_marginTop="16dp"/>
        <Spinner android:id="@+id/sp_motif_xx" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btn_inspecter_xx" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Inspecter le profil"/>
    </LinearLayout>
</ScrollView>