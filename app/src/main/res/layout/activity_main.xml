<?xml version="1.0" encoding="utf-8"?>
<!-- 1) ecran 1: el formulaire, fond beige style passeport 9dim -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5E6C8"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 0) el logo mte3 el app fou9 el titre -->
        <ImageView
            android:id="@+id/img_logo_am"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:contentDescription="Logo Douane Temporelle"
            android:src="@drawable/ic_passeport" />

        <!-- 2) el titre w el sous-titre -->
        <TextView
            android:id="@+id/tv_titre_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="DOUANE TEMPORELLE"
            android:textColor="#5D4037"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_soustitre_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Poste de contrôle des voyageurs du temps"
            android:textColor="#8D6E63"
            android:textSize="14sp" />

        <!-- 3) les champs mte3 el formulaire -->
        <EditText
            android:id="@+id/et_nom_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom du voyageur"
            android:inputType="textPersonName"
            android:textColor="#3E2723"
            android:textColorHint="#8D6E63" />

        <EditText
            android:id="@+id/et_naissance_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Année de naissance (ex: 1990)"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="#3E2723"
            android:textColorHint="#8D6E63" />

        <EditText
            android:id="@+id/et_destination_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Année de destination (ex: 2050)"
            android:inputType="number"
            android:maxLength="4"
            android:textColor="#3E2723"
            android:textColorHint="#8D6E63" />

        <!-- 4) el motif mte3 es-safra -->
        <TextView
            android:id="@+id/tv_label_motif_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Motif du voyage"
            android:textColor="#5D4037"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_motif_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 5) btn li ycheckii -->
        <Button
            android:id="@+id/btn_inspecter_am"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="Inspecter le profil"
            android:textColor="#F5E6C8"
            android:textSize="16sp"
            app:backgroundTint="#5D4037"
            app:cornerRadius="12dp" />
    </LinearLayout>
</ScrollView>
