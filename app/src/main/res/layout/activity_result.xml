<?xml version="1.0" encoding="utf-8"?>
<!-- 1) ecran 3: el verdict. el jedhr LinearLayout w el background yetbaddel mel Java (khdher wala a7mer) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_racine_am"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 2) el tampon: ktiba mayla fi 7a9ha el bordure -->
    <TextView
        android:id="@+id/tv_tampon_am"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tampon"
        android:letterSpacing="0.1"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:rotation="-12"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- 3) el message mte3 el verdict -->
    <TextView
        android:id="@+id/tv_message_am"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 4) zorr el rjou3 lel formulaire -->
    <Button
        android:id="@+id/btn_nouveau_am"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="52dp"
        android:text="Nouveau voyageur"
        android:textColor="#5D4037"
        app:backgroundTint="#F5E6C8"
        app:cornerRadius="12dp" />
</LinearLayout>